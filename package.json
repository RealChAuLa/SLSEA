{
  "name": "slsea-solar-api",
  "version": "0.0.0",
  "private": true,
  "description": "SLSEA real-time solar generation data API",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "node scripts/generate-client.js && node scripts/build-spec.js",
    "db:generate": "node scripts/generate-client.js",
    "spec:build": "node scripts/build-spec.js",
    "spec:lint": "node scripts/build-spec.js && redocly lint openapi.yaml openapi.json",
    "pretest": "node scripts/generate-client.js && node scripts/build-spec.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit --runInBand",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "db:migrate": "node scripts/migrate.js",
    "seed": "node prisma/seed.js",
    "seed:tokens": "node prisma/seed-tokens.js",
    "seed:extend": "node scripts/not-implemented.js seed:extend I7",
    "simulate": "node scripts/not-implemented.js simulate I6"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "clearMocks": true,
    "restoreMocks": true
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.62.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "typescript": "7.0.2"
  }
}
