# I0 runtime settings. Empty CORS_ORIGINS disables cross-origin browser access.
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000

# Reserved for later increments; these are not required or read in I0.
# Do not place real credentials in this example file.
DATABASE_URL=
DIRECT_URL=
TEST_DATABASE_URL=
JWT_SECRET=
JWT_ISSUER=slsea-solar-api
JWT_AUDIENCE=slsea-solar-api
USER_TOKEN_TTL_SECONDS=3600
DEVICE_TOKEN_TTL_DAYS=365
STALE_AFTER_MINUTES=30
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500
MAX_POWER_KW=50
SEED_DEMO_PASSWORD=
SEED_RANDOM=20260601
API_BASE_URL=http://localhost:3000
