# Public health/docs settings. Empty CORS_ORIGINS disables cross-origin browser access.
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true

# Private owner-selected Neon target. Never put real credentials in this file.
# Runtime URL is pooled. DIRECT_URL is a non-pooled URL for migrations/seed.
DATABASE_URL=
DIRECT_URL=
# Test URL must be direct. Shared use requires the explicit opt-in below.
TEST_DATABASE_URL=
# Destructive testing on the application DB requires explicit owner authorization.
TEST_ALLOW_SHARED_DATABASE=no
# Supply at least 32 random bytes; never commit the value.
JWT_SECRET=
JWT_ISSUER=slsea-solar-api
JWT_AUDIENCE=slsea-solar-api
USER_TOKEN_TTL_SECONDS=3600
DEVICE_TOKEN_TTL_DAYS=365
STALE_AFTER_MINUTES=30
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500
MAX_POWER_KW=50
SEED_DEMO_PASSWORD="Solar#Demo2026"
SEED_RANDOM=20260601
# Seeding is destructive; prefer a one-off npm run seed -- --yes.
SEED_CONFIRM=no
# Owner HTTP simulator and smoke CLI origin.
API_BASE_URL=http://localhost:3000
