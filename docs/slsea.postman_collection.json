    {
      "name": "Device ingestion",
      "item": [
        {
          "name": "POST /v1/installations/1/readings - Create a reading for installation 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{deviceToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/installations/1/readings",
            "description": "Creates a real reading. First send Latest reading for installation 1; then set the private site-1 deviceToken. Repeated timestamp returns 409. Refresh Latest reading before another POST.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timestamp\": \"{{newReadingTimestamp}}\",\n  \"power_Kw\": 1,\n  \"cumulative_energy_Kwh\": {{nextCounter}},\n  \"voltage\": 230\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
