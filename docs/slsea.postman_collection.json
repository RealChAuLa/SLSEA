              }
            ],
            "url": "{{baseUrl}}/v1/installations/1/last-known-reading",
            "description": "Expected 200. Use the National Operator login for these IDs."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const reading = pm.response.json();",
                  "  pm.collectionVariables.set(\"existingReadingTimestamp\", reading.timestamp);",
                  "  const nextMs = Math.max(Date.now(), Date.parse(reading.timestamp) + 1000);",
                  "  pm.collectionVariables.set(\"newReadingTimestamp\", new Date(nextMs).toISOString());",
                  "  pm.collectionVariables.set(\"nextCounter\", Number((reading.cumulative_energy_Kwh + 0.01).toFixed(3)));",
                  "}"
                ]
              }
            }
          ]
        },
