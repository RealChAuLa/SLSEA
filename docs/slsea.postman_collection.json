    {
      "name": "Password changes - run last",
      "item": [
        {
          "name": "PATCH /v1/users/3 - Reset user 3 password",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/users/3",
            "description": "National login resets Western Province Officer (user 3). To restore the demo password, send this request again with new_password equal to Solar#Demo2026. This revokes that user’s old tokens.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"new_password\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "PATCH /v1/users/me - Change your own password",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/users/me",
            "description": "Changes the logged-in user password and revokes userToken. Log in again with the changed password. Recovery instructions are in docs/postman-curl.md.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"{{password}}\",\n  \"new_password\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
